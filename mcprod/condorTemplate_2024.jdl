universe = vanilla
executable = runGeneration_2024.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# No output files to transfer by default
transfer_output_files = ""

# Dummy input
input = /dev/null

# Resource requests
rank = Mips
request_memory = 16000

# Accounting and project info
+AcctGroup = "analysis"
+ProjectName = "DarkMatterSimulation"
+DesiredOS = "EL9"

# acrobert additions
request_memory = 8096M
request_disk   = 8096M
+MaxRuntime = 172800
x509userproxy = /uscms/home/acrobert/x509up_u57074
MY.SingularityImage = "/cvmfs/singularity.opensciencegrid.org/cmssw/cms:rhel9"

# Handle transient XRootD or other non-zero exit code failures:
on_exit_remove = (ExitBySignal == False) && (ExitCode == 0)
on_exit_hold = ( (ExitBySignal == True) || (ExitCode != 0) )
on_exit_hold_reason = strcat("Job held by ON_EXIT_HOLD due to ",\
ifThenElse((ExitBySignal == True), "exit by signal", \
strcat("exit code ",ExitCode)), ".")
